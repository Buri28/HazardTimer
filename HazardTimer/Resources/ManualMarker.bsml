<bg xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="https://monkeymanboy.github.io/BSML-Docs/ https://raw.githubusercontent.com/monkeymanboy/BSML-Docs/gh-pages/BSMLSchema.xsd">

  <horizontal spacing='3' preferred-width='115'>

    <vertical child-control-height='false' spacing='2' preferred-width='42'
              vertical-fit='PreferredSize' child-align='MiddleCenter'>
      <horizontal bg='round-rect-panel' bg-color='#00000077' pad='1'>
        <list id='marker-list'
              select-cell='marker-selected'
              visible-cells='7'
              cell-size='6'/>
      </horizontal>
      <horizontal>
        <page-button event-click='marker-list#PageUp' direction='Up' preferred-width='20'/>
        <page-button event-click='marker-list#PageDown' direction='Down' preferred-width='20'/>
      </horizontal>
    </vertical>

    <vertical spacing='1' horizontal-fit='Unconstrained'>

      <horizontal spacing='1' pad='0' pref-height='7'>
        <text id='status-text' text='' font-size='3' align='Left'/>
        <button text='Settings' click-event='show-settings' pref-width='30'
                hover-hint='Open the HazardTimer settings.'/>
      </horizontal>

      <vertical horizontal-fit='Unconstrained' child-control-height='false' child-expand-height='false'
                bg='round-rect-panel' bg-color='#00000077' pad='1' pad-left='2' pad-right='2'>
        <horizontal spacing='1'>
          <button text='Import' on-click='import-replays' pref-width='33'
                  hover-hint='Re-import this beatmap from your local replays. No network access.'/>
          <button text='Delete All' on-click='clear-all' pref-width='33'
                  hover-hint='Delete every marker for this beatmap and stop auto import.'/>
        </horizontal>
      </vertical>

      <vertical horizontal-fit='Unconstrained' child-control-height='false' child-expand-height='false'
                bg='round-rect-panel' bg-color='#00000077' pad='1' pad-left='2' pad-right='2'>
        <string-setting
          text='Label'
          value='label'
          hover-hint='Display name. Empty falls back to WALL / FAIL / MARK.'
          apply-on-change='true'
          bind-value='true'/>

        <increment-setting
          text='Minutes'
          value='minutes'
          integer-only='true'
          min='0' max='20' increment='1'
          apply-on-change='true'
          bind-value='true'/>

        <slider-setting
          text='Seconds'
          value='seconds'
          integer-only='true'
          min='0' max='59' increment='1'
          show-buttons='true'
          apply-on-change='true'
          bind-value='true'/>

        <horizontal spacing='1'>
          <button text='Delete' on-click='delete-selected' pref-width='22'
                  hover-hint='Delete the selected marker. Imported ones can be restored with Import.'/>
          <button text='Update' on-click='update-selected' pref-width='22'
                  hover-hint='Write these values back to the selected marker.'/>
          <button text='Add' on-click='add-marker' pref-width='22'
                  hover-hint='Add a new marker with these values.'/>
        </horizontal>
        <horizontal spacing='1'>
          <button text='Turn On' on-click='turn-on' pref-width='33'
                  hover-hint='Always count down to this marker. Only markers at almost the same time are turned off.'/>
          <button text='Turn Off' on-click='turn-off' pref-width='33'
                  hover-hint='Stop using this marker without deleting it. Nothing else is changed.'/>
        </horizontal>
        <horizontal spacing='1'>
          <button text='All Off' on-click='all-off' pref-width='33'
                  hover-hint='Turn off every marker for this beatmap without deleting them.'/>
          <button text='All Auto' on-click='all-auto' pref-width='33'
                  hover-hint='Drop every On / Off you set here and go back to automatic selection.'/>
        </horizontal>
      </vertical>

    </vertical>

  </horizontal>

  <modal id='settings-modal' show-event='show-settings' hide-event='hide-settings'
         click-off-closes='true' move-to-center='true'
         size-delta-x='106' size-delta-y='72'>
    <vertical spacing='1' pad='2'>

      <slider-setting
        text='Countdown Time'
        hover-hint='How long the countdown is shown before you reach a marker.'
        value='lead-time'
        min='1' max='30' increment='0.5'
        formatter='FormatSeconds'
        show-buttons='true'
        apply-on-change='true'
        bind-value='true'/>

      <slider-setting
        text='Merge Interval'
        hover-hint='Records closer together than this are treated as one spot. Only one is picked automatically; markers you turn on are all kept.'
        value='cluster-threshold'
        min='0.5' max='15' increment='0.5'
        formatter='FormatSeconds'
        show-buttons='true'
        apply-on-change='true'
        bind-value='true'/>

      <toggle-setting
        text='Show Fail Marker'
        hover-hint='Count down to your fail point. Applies to every beatmap. Markers are kept either way.'
        value='show-fail-marker'
        apply-on-change='true'
        bind-value='true'/>

      <toggle-setting
        text='Show Miss Markers'
        hover-hint='Count down to missed-note spots. Applies to every beatmap. Markers are kept either way.'
        value='show-miss-markers'
        apply-on-change='true'
        bind-value='true'/>

      <toggle-setting
        text='Show Bomb Markers'
        hover-hint='Count down to bomb-hit spots. Applies to every beatmap. Markers are kept either way.'
        value='show-bomb-markers'
        apply-on-change='true'
        bind-value='true'/>

      <toggle-setting
        text='Show Wall Markers'
        hover-hint='Count down to wall-hit spots. Applies to every beatmap. Markers are kept either way.'
        value='show-wall-markers'
        apply-on-change='true'
        bind-value='true'/>

      <toggle-setting
        text='Auto Import Replays'
        hover-hint='Import from your local replays when a beatmap is selected. No network access.'
        value='auto-import-replays'
        apply-on-change='true'
        bind-value='true'/>

      <increment-setting
        text='Max Import Replays'
        hover-hint='How many replays to read per beatmap, newest first.'
        value='max-import-replays'
        integer-only='true'
        min='1' max='50' increment='1'
        apply-on-change='true'
        bind-value='true'/>

      <increment-setting
        text='Max Miss Markers'
        hover-hint='How many missed-note spots to import. The spot with the most misses is turned on, the rest are added turned off. 0 imports none.'
        value='max-miss-markers'
        integer-only='true'
        min='0' max='50' increment='1'
        apply-on-change='true'
        bind-value='true'/>

      <increment-setting
        text='Max Bomb Markers'
        hover-hint='How many bomb-hit spots to import. Bombs are rarer than misses, so imported spots are turned on. 0 imports none.'
        value='max-bomb-markers'
        integer-only='true'
        min='0' max='50' increment='1'
        apply-on-change='true'
        bind-value='true'/>

      <button text='Close' click-event='hide-settings' pref-width='33'/>

    </vertical>
  </modal>
</bg>
