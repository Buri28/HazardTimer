<vertical spacing="1" horizontal-fit="PreferredSize"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="https://monkeymanboy.github.io/BSML-Docs/ https://raw.githubusercontent.com/monkeymanboy/BSML-Docs/gh-pages/BSMLSchema.xsd">

  <slider-setting
    text='Lead Time'
    hover-hint='何秒前からカウントダウンを表示するか'
    value='lead-time'
    min='1'
    max='30'
    increment='0.5'
    formatter='FormatSeconds'
    show-buttons='true'
    apply-on-change='true'
    bind-value='true'/>

  <slider-setting
    text='Cluster Threshold'
    hover-hint='この秒数未満で続く壁への接触は、1つの危険地点にまとめる'
    value='cluster-threshold'
    min='0.5'
    max='15'
    increment='0.5'
    formatter='FormatSeconds'
    show-buttons='true'
    apply-on-change='true'
    bind-value='true'/>

  <toggle-setting
    text='Record Wall Hits'
    hover-hint='壁に当たった地点を記録する'
    value='record-wall-hits'
    apply-on-change='true'
    bind-value='true'/>

  <toggle-setting
    text='Record Fails'
    hover-hint='フェイルした地点を記録する（NoFail 中は記録しない）'
    value='record-fails'
    apply-on-change='true'
    bind-value='true'/>

  <toggle-setting
    text='Show Fail Marker'
    hover-hint='フェイル地点のカウントダウンを他と併記する'
    value='show-fail-marker'
    apply-on-change='true'
    bind-value='true'/>

  <toggle-setting
    text='Auto Import Replays'
    hover-hint='曲を選んだとき、その譜面の過去のリプレイから自動で取り込む（通信は行わない）'
    value='auto-import-replays'
    apply-on-change='true'
    bind-value='true'/>

  <slider-setting
    text='Counter X Offset'
    value='counter-x-offset'
    min='-20'
    max='20'
    increment='0.1'
    formatter='FormatOneDecimal'
    show-buttons='true'
    apply-on-change='true'
    bind-value='true'/>

  <slider-setting
    text='Counter Y Offset'
    value='counter-y-offset'
    min='-20'
    max='20'
    increment='0.1'
    formatter='FormatOneDecimal'
    show-buttons='true'
    apply-on-change='true'
    bind-value='true'/>
</vertical>
