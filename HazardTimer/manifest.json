{
  "$schema": "https://raw.githubusercontent.com/beat-saber-modding-group/BSIPA-MetadataFileSchema/master/schema.json",
  "author": "Buri28",
  "description": "Counts down the seconds until the next hazard in a map - walls you have hit, where you failed, and points you mark yourself.",
  "gameVersion": "1.40.8",
  "id": "HazardTimer",
  "name": "HazardTimer",
  "version": "0.1.0",
  "dependsOn": {
    "BSIPA": "^4.3.0",
    "BeatSaberMarkupLanguage": "^1.12.0",
    "SiraUtil": "^3.1.0",
    "Counters+": "^2.3.0"
  },
  "loadAfter": [
    "BeatSaberMarkupLanguage",
    "Counters+"
  ],
  "features": {
    "CountersPlus.CustomCounter": {
      "Name": "Hazard Timer",
      "CounterLocation": "HazardTimer.UI.HazardTimerCounter",
      "MultiplayerReady": true,
      "BSML": {
        "Resource": "HazardTimer.Resources.CounterSettings.bsml",
        "Host": "HazardTimer.UI.SettingController",
        "Icon": "HazardTimer.Resources.icon.png"
      },
      "ConfigDefaults": {
        "Enabled": true,
        "Position": "AboveHighway",
        "Distance": 1
      }
    }
  }
}
