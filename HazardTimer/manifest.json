{
  "$schema": "https://raw.githubusercontent.com/beat-saber-modding-group/BSIPA-MetadataFileSchema/master/schema.json",
  "author": "Buri28",
  "description": "譜面中の危険地点（壁に当たった場所・フェイルした場所・手動で指定した時刻）までの残り秒数をカウントダウン表示するMOD",
  "gameVersion": "1.40.8",
  "id": "HazardTimer",
  "name": "HazardTimer",
  "version": "0.1.0",
  "dependsOn": {
    "BSIPA": "^4.3.0",
    "BeatSaberMarkupLanguage": "^1.12.0",
    "SiraUtil": "^3.1.0",
    "Counters+": "^2.3.0"
  },
  "loadAfter": [
    "BeatSaberMarkupLanguage",
    "Counters+"
  ],
  "features": {
    "CountersPlus.CustomCounter": {
      "Name": "Hazard Timer",
      "CounterLocation": "HazardTimer.UI.HazardTimerCounter",
      "MultiplayerReady": false,
      "BSML": {
        "Resource": "HazardTimer.Resources.SettingsUI.bsml",
        "Host": "HazardTimer.UI.SettingController"
      },
      "ConfigDefaults": {
        "Enabled": true,
        "Position": "AboveHighway",
        "Distance": 1
      }
    }
  }
}
